{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rapier JXL",
  "version": "0.1.0",
  "identifier": "dev.example.rapier-jxl",
  "build": {"frontendDist": "../web"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "JPEG XL", "width": 720, "height": 560, "dragDropEnabled": false}],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost blob:; img-src 'self' blob: data:; media-src blob:; base-uri 'none'",
      "headers": {"Cross-Origin-Opener-Policy": "same-origin", "Cross-Origin-Embedder-Policy": "require-corp", "Cross-Origin-Resource-Policy": "same-origin"}
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.png", "icons/icon.ico"]}
}
