{
  "name": "rapier-jxl",
  "version": "2.1.0",
  "description": "A JPEG XL encoder in pure JavaScript, lossless and lossy, in one file of 19.5 kB, 8.5 kB gzipped; JPEGs and photographs are their own doors. The encoder inside Rapier.",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./min": {
      "types": "./index.d.mts",
      "default": "./rapier-jxl.min.mjs"
    },
    "./jpeg": {
      "types": "./jpeg.d.mts",
      "default": "./jpeg.mjs"
    },
    "./photo": {
      "types": "./photo.d.mts",
      "default": "./photo.mjs"
    },
    "./jpeg-ans": {
      "types": "./jpeg-ans.d.mts",
      "default": "./jpeg-ans.mjs"
    },
    "./photo-ans": {
      "types": "./photo-ans.d.mts",
      "default": "./photo-ans.mjs"
    },
    "./effort": {
      "types": "./effort.d.mts",
      "default": "./effort.mjs"
    },
    "./writer": "./writer.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "README.md",
    "AGENTS.md",
    "ENCODER-COMPARISON.md",
    "LICENSE",
    "sizes.json",
    "public/encoders.json",
    "public/encoder-sizes.json",
    "public/measure-encoders.mjs",
    "public/examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackskip22/rapier-jxl.git"
  },
  "homepage": "https://rapier.website",
  "keywords": [
    "jpeg-xl",
    "jpegxl",
    "jxl",
    "encoder",
    "image-compression",
    "rapier"
  ],
  "scripts": {
    "test": "node --test \"public/test/*.test.mjs\"",
    "fuzz:scale": "node public/test/fuzz-shards.mjs"
  },
  "devDependencies": {
    "jxl-oxide-wasm": "0.12.6",
    "terser": "5.51.2"
  }
}
