{
  "name": "rapier-jxl",
  "version": "1.1.21",
  "description": "A JPEG XL encoder in pure JavaScript: lossless, lossy, and a JPEG carried as its coefficients. One file of 36.3 kB, 15.0 kB gzipped. The encoder inside Rapier.",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./min": {
      "types": "./index.d.mts",
      "default": "./rapier-jxl.min.mjs"
    },
    "./lossless": {
      "types": "./lossless.d.mts",
      "default": "./lossless.min.mjs"
    },
    "./jpeg": {
      "types": "./jpeg.d.mts",
      "default": "./jpeg.min.mjs"
    },
    "./photo": {
      "types": "./photo.d.mts",
      "default": "./photo.min.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "README.md",
    "AGENTS.md",
    "ENCODER-COMPARISON.md",
    "LICENSE",
    "sizes.json",
    "public/encoders.json",
    "public/encoder-sizes.json",
    "public/measure-encoders.mjs",
    "public/examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackskip22/rapier-jxl.git"
  },
  "homepage": "https://rapier.website",
  "keywords": [
    "jpeg-xl",
    "jpegxl",
    "jxl",
    "encoder",
    "image-compression",
    "rapier"
  ],
  "scripts": {
    "test": "node --test \"public/test/*.test.mjs\"",
    "fuzz:scale": "node public/test/fuzz-shards.mjs"
  },
  "devDependencies": {
    "jxl-oxide-wasm": "0.12.6",
    "terser": "5.51.2"
  }
}
