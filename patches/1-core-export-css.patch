     ? (Number.isFinite(context.width) ? meta.targetW / meta.vbW : meta.targetH / meta.vbH) : 1
   const intrinsicY = sizedSVG
     ? (Number.isFinite(context.height) ? meta.targetH / meta.vbH : meta.targetW / meta.vbW) : 1
+  // `css` styles one export. Its rules join the engine's <style>, the first in the svg (which
+  // internInlineStyles and fileSvgText already rely on), in a cascade layer that this <style>
+  // declares first: its !important wins over every stylesheet rule in the capture.
   const exportSource = (options) => {
+    const source = drawnSource(options), css = options.css
+    if (css == null || css === '') return source
+    if (typeof css !== 'string') throw new TypeError('[SnapDOM] css is a string of style rules.')
+    if (typeof source !== 'string') throw new RangeError('[SnapDOM] Only SVG captures can be styled.')
+    const i = source.indexOf(',') + 1, svg = decodeURIComponent(source.slice(i))
+    const open = svg.indexOf('>', svg.indexOf('<style')) + 1, close = svg.indexOf('</style>')
+    const rules = css.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    return source.slice(0, i) + encodeURIComponent(svg.slice(0, open) + '@layer snapdom-export;' +
+      svg.slice(open, close) + `@layer snapdom-export{${rules}}` + svg.slice(close))
+  }
+  const drawnSource = (options) => {
     if (engineCanvas || !originals?.size) return pixelSource
     let w = meta.vbW, h = meta.vbH
     const crop = options.crop
@@ -307,6 +321,7 @@ async function buildResult(url, context) {
   }
 
   const rasterEngineImage = async (ctx, opts) => {
+    if (opts?.css) throw new RangeError('[SnapDOM] Only SVG captures can be styled.')
     const { rasterize } = await import('../modules/rasterize.js')
     return rasterize(pixelSource, { ...ctx, ...(opts || {}), format: 'png' })
   }
