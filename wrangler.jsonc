{
  "name": "rapier-jxl-tester",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "rapier-jxl-tester-results" }],
  "observability": { "enabled": true }
}
