+    const stub = { userAgentData: { platform: 'iOS' }, canShare: () => true, share: async () => { seen.shares++; if (refusal) throw refusal } }
+    for (const [k, value] of Object.entries(stub)) Object.defineProperty(navigator, k, { value, configurable: true })
